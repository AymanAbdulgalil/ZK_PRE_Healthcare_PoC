# Copy to .env and fill in real values. Never commit the real .env.

# --- MinIO (encrypted ciphertext blob storage) ------------------------------
# Root credentials: MinIO, minio-init and the dashboard only; never the clients.
MINIO_ROOT_USER=zkpre_admin
MINIO_ROOT_PASSWORD=change_me_min_8_chars

# One MinIO user per client (owner: store and erase; provider: read).
# Users 3+ chars, passwords 8+, only letters, digits and . _ ~ - ; users must differ.
# Use a separate random password for each: openssl rand -hex 24
OWNER_MINIO_USER=zkpre_patient
OWNER_MINIO_PASSWORD=change_me_patient_pw
PROVIDER_MINIO_USER=zkpre_provider
PROVIDER_MINIO_PASSWORD=change_me_provider_pw

# Dashboard port, loopback only. Change it if taken (e.g. by Cockpit).
MINIO_CONSOLE_PORT=9090

# --- Umbral threshold PRE (m-of-n: m nodes needed to reconstruct access) ----
PRE_THRESHOLD=2
PRE_SHARES=3

# --- Local Hardhat chain -----------------------------------------------------
HARDHAT_CHAIN_ID=31337
# The contract address comes from the ledger-data volume; nothing to set.

# No verifier key: the contract has no privileged account (R6).

# --- owner (shown as "Patient" in the interface) ---------------------------
# Hardhat dev account #2: public and pre-funded. Local chain only.
OWNER_ETH_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# --- provider (shown as "Health Care Provider" in the interface) ------------
# Hardhat dev account #3: public and pre-funded. Local chain only.
PROVIDER_ETH_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
